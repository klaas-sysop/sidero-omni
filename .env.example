# Omni Version
OMNI_VERSION=0.41.0

# Account UUID (will be generated if not set)
OMNI_ACCOUNT_UUID=

# Domain Configuration
OMNI_DOMAIN_NAME=omni.example.com
OMNI_WG_IP=10.10.1.100

# Admin Configuration
OMNI_ADMIN_EMAIL=admin@example.com
OMNI_NAME=onprem-omni

# Certificate Paths
# For self-signed certificates (testing), these will be auto-generated
# For production, point to your certificate files
TLS_CERT_PATH=./certs/tls.crt
TLS_KEY_PATH=./certs/tls.key

# GPG Key Path
GPG_KEY_PATH=./omni.asc

# Auth0 Configuration
AUTH0_ENABLED=true
AUTH0_DOMAIN=dev-xxxxx.us.auth0.com
AUTH0_CLIENT_ID=your-client-id-here

# SAML Configuration (alternative to Auth0)
# Set AUTH0_ENABLED=false and configure SAML if using SAML instead
# AUTH_SAML_ENABLED=false
# AUTH_SAML_URL=
